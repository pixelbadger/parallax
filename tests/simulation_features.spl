# Exercises the simulation features: assignment, loops, ranged randomness,
# lazy built-ins, strings, multiverse, given and timeline isolation.
type Roll = { total, double };

fn roll() = { open(1, 6) }

fn main() = {
    seed(11);

    # Assignment and loops
    let total = 0;
    repeat 10 { total = total + 1; }
    let i = 0;
    while (i < 5) { i = i + 1; }
    print("loops", total, i);

    # Deep recursion
    fn count(n) = { if (n == 0) { 0 } else { 1 + count(n - 1) } }
    print("recursion", count(3000));

    # Ranged randomness with lazy bounds, lazy built-ins
    let d = roll();
    let bigger = open(d, d + 10);
    let spread : ~Int = max(bigger - d, 0);
    print("ranged", d < bigger + 1, spread < 11, min(3, 9), abs(0 - 4));

    # Multiverse over ints and structs, with conditioning
    let sevens = multiverse 600 { roll() + roll() == 7 };
    print("sevens", sevens.n, sevens.hits);
    let pairs = multiverse 600 {
        let a = roll(); let b = roll();
        given a > 3;
        Roll { total: a + b, double: a == b }
    };
    print("given", pairs.total.n, pairs.total.rejected, pairs.total.min, pairs.double.hits);

    # Same-size multiverses share their draws (common random numbers),
    # and running a multiverse does not disturb the outer timeline
    seed(11);
    let first = multiverse 50 { roll() };
    let after = observe roll();
    let again = multiverse 50 { roll() };   # later in the outer stream
    seed(11);
    print("crn", first.total == again.total, after == observe roll());

    # A fork draws from its own stream: forking does not change later draws
    seed(5);
    let peek = fork { observe roll() };
    discard peek;
    let real = observe roll();
    seed(5);
    print("isolation", real == observe roll());

    # commit applies only what the fork wrote
    let a = 1;
    let b = 1;
    let f = fork { a = 10; 0 };
    b = 20;
    commit f;
    print("commit", a, b);

    # given outside a multiverse that holds is a no-op
    given 1;
    print("done");
}
