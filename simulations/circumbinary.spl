# ============================================================
# Circumbinary: can a habitat hold an orbit around two suns?
#
# A three-body problem. Two stars (masses 65 and 34) orbit each other
# 1 AU apart, and a habitat orbits the pair further out. All three pull
# on each other: every step sums the gravity of every pair of bodies.
#
# Close to a binary, orbits are chaotic: a habitat that starts too close
# is flung out of the system or falls into a star, and tiny differences
# in where it starts decide which. Its launch was imprecise:
#   orbit radius   1.4 - 3.0 AU around the pair
#   orbital phase  anywhere on the circle
#   the stars move at 85 - 100% of circular speed (an unknown eccentricity)
# and every 150 steps a random knock (debris, outgassing) nudges it.
#
# Mission control has fuel for 8 thruster burns, and three policies:
#   DRIFT     never burn
#   FORECAST  every 150 steps, simulate coasting, a prograde burn and a
#             retrograde burn for 75 steps each in forks, then make the
#             burn that looked best
#   EDIT      every 150 steps, *live* all three options in forks, commit
#             the best future and discard the others
# Forecasts draw their own random knocks, so they can be wrong. EDIT
# can't be: it keeps a future that already happened.
#
# Units: positions in P (1 AU = 100000 P), velocities in V = P/1000 per
# step, and one step is 1/160 of the binary's period. Integer gravity
# with a softened inverse-square force and a semi-implicit Euler step.
# ============================================================

# Bodies 0 and 1 are the stars, 2 is the habitat. d holds the distance of
# each pair (AB, AH, BH): it is the starting guess for the next square root.
type Sky = { x, y, vx, vy, gm, d };
type Leg = { sky, steps, habitable, fate };
type Fate = { kept, ejected, crashed, habitable, burns, track, inner };

let AU = 100000;
let G = 15600000000;
let MA = 65;
let MB = 34;
let MT = 99;
let EPS2 = 3000 * 3000;      # softening, so close passes stay finite
let PAIR_I = [0, 0, 1];
let PAIR_J = [1, 2, 2];

let STEPS = 750;             # 4.7 orbits of the binary
let WINDOW = 150;            # how often mission control decides
let LOOK = 75;               # how far a forecast looks ahead
let KNOCK = 30000;           # random nudge per window, V (~1.5% of orbital speed)
let BURN = 150000;           # one thruster burn, V (~7% of orbital speed)
let FUEL = 8;
let HZ_IN = 180000;          # habitable between 1.8 and 2.8 AU
let HZ_OUT = 280000;
let CRASH = 15000;           # closer than 0.15 AU to a star: lost
let ESCAPE = 1000000;        # further than 10 AU: lost
let LOST = 0 - 1000000;
let UNIVERSES = 24;

let DRIFT = 0;
let FORECAST = 1;
let EDIT = 2;

fn isqrt(n, guess) = {
    let x = max(guess, 1);
    while (x * x < n) { x = x * 2; }
    let y = (x + n / x) / 2;
    while (y < x) { x = y; y = (x + n / x) / 2; }
    x
}

fn drift(x, v) = { x + (v + 500) / 1000 }

# The habitat's distance from the pair: the mean of its distances to each star.
fn reach(s) = { (s.d[1] + s.d[2]) / 2 }

# A random knock, then up to n steps; stops early if the habitat is lost.
# The step is written inline, not as a function: arrays have value
# semantics, so `s = step(s)` would copy them every step, while writes to
# a local `s` happen in place.
fn fly(s, n) = {
    s.vx[2] = s.vx[2] + observe open(0 - KNOCK, KNOCK);
    s.vy[2] = s.vy[2] + observe open(0 - KNOCK, KNOCK);
    let k = 0;
    let fate = 0;   # 1 ejected, 2 crashed
    let habitable = 0;
    while (k < n && fate == 0) {
        # Every pair pulls on each other...
        let ax = [0, 0, 0];
        let ay = [0, 0, 0];
        let p = 0;
        while (p < 3) {
            let i = PAIR_I[p];
            let j = PAIR_J[p];
            let dx = s.x[j] - s.x[i];
            let dy = s.y[j] - s.y[i];
            let d = isqrt(dx * dx + dy * dy + EPS2, s.d[p]);
            s.d[p] = d;
            # a = GM dx / d^3, ordered so no product can overflow
            let d2 = d * d;
            let pi = s.gm[j] * 1000 / d;
            let pj = s.gm[i] * 1000 / d;
            ax[i] = ax[i] + pi * dx / d2;
            ay[i] = ay[i] + pi * dy / d2;
            ax[j] = ax[j] - pj * dx / d2;
            ay[j] = ay[j] - pj * dy / d2;
            p = p + 1;
        }
        # ...then every body moves
        let b = 0;
        while (b < 3) {
            s.vx[b] = s.vx[b] + ax[b];
            s.vy[b] = s.vy[b] + ay[b];
            s.x[b] = drift(s.x[b], s.vx[b]);
            s.y[b] = drift(s.y[b], s.vy[b]);
            b = b + 1;
        }
        k = k + 1;
        let r = reach(s);
        if (r > HZ_IN && r < HZ_OUT) { habitable = habitable + 1; }
        if (r > ESCAPE) { fate = 1; }
        if (s.d[1] < CRASH || s.d[2] < CRASH) { fate = 2; }
    }
    Leg { sky: s, steps: k, habitable: habitable, fate: fate }
}

fn score(leg) = { if (leg.fate == 0) { leg.habitable } else { LOST } }

# Fire the habitat's thruster along its direction of travel.
fn burn(s, dv) = {
    let speed = isqrt(s.vx[2] * s.vx[2] + s.vy[2] * s.vy[2], 1);
    s.vx[2] = s.vx[2] + s.vx[2] * dv / speed;
    s.vy[2] = s.vy[2] + s.vy[2] * dv / speed;
    s
}

# The stars on a (possibly eccentric) orbit about their centre of mass, and
# the habitat on a circular orbit of radius r0 at a random phase. The phase
# is a rational point on the circle, (1 - t^2, 2t) / (1 + t^2), so no trig.
fn launch(r0) = {
    let ecc = observe open(85, 100);
    let vb = isqrt(G * MT * 1000000 / AU, 1) * ecc / 100;
    let t = observe open(0 - 1000, 1000);
    let flip = observe open(0, 1) * 2 - 1;
    let c = (1000000 - t * t) * 1000 / (1000000 + t * t) * flip;
    let sn = 2 * t * 1000000 / (1000000 + t * t) * flip;
    let vh = isqrt(G * MT * 1000000 / r0, 1);
    Sky {
        x: [0 - AU * MB / MT, AU * MA / MT, r0 * c / 1000],
        y: [0, 0, r0 * sn / 1000],
        vx: [0, 0, 0 - vh * sn / 1000],
        vy: [0 - vb * MB / MT, vb * MA / MT, vh * c / 1000],
        gm: [G * MA, G * MB, 1000000],
        d: [AU, r0, r0],
    }
}

fn voyage(policy) = {
    let r0 = observe open(140000, 300000);
    let s = launch(r0);
    let t = 0;
    let fate = 0;
    let habitable = 0;
    let burns = 0;
    # distance from the pair (0.1 AU) after each window
    let track = array(STEPS / WINDOW, 0 - 1);

    # Live one window, after a burn if dv is not 0. A closure over this
    # voyage: called inside a fork, it advances the fork's copy instead.
    fn live(dv) = {
        if (dv == 0) { } else { s = burn(s, dv); burns = burns + 1; }
        let leg = fly(s, WINDOW);
        s = leg.sky;
        t = t + leg.steps;
        habitable = habitable + leg.habitable;
        fate = leg.fate;
        track[(t - 1) / WINDOW] = reach(s) / 10000;
        score(leg)
    }

    while (t < STEPS && fate == 0) {
        let fuel = burns < FUEL;
        if (policy == DRIFT || fuel == 0) { live(0); }
        if (policy == FORECAST && fuel) {
            let coast = fork { score(fly(s, LOOK)) };
            let up = fork { score(fly(burn(s, BURN), LOOK)) };
            let down = fork { score(fly(burn(s, 0 - BURN), LOOK)) };
            let dv = 0;
            if (up > coast && up > down) { dv = BURN; }
            if (down > coast && down > up) { dv = 0 - BURN; }
            discard coast;
            discard up;
            discard down;
            live(dv);
        }
        if (policy == EDIT && fuel) {
            let coast = fork { live(0) };
            let up = fork { live(BURN) };
            let down = fork { live(0 - BURN) };
            if (up > coast && up > down) {
                commit up; discard coast; discard down;
            } else {
                if (down > coast && down > up) {
                    commit down; discard coast; discard up;
                } else {
                    commit coast; discard up; discard down;
                }
            }
        }
    }

    # A lost habitat stays where it was last seen
    let w = 1;
    while (w < len(track)) {
        if (track[w] < 0) { track[w] = track[w - 1]; }
        w = w + 1;
    }
    Fate {
        kept: fate == 0, ejected: fate == 1, crashed: fate == 2,
        habitable: habitable * 100 / STEPS, burns: burns, track: track,
        inner: r0 < 2 * AU,
    }
}

fn medians(track) = {
    let out = [];
    let i = 0;
    while (i < len(track)) { out = push(out, track[i].median); i = i + 1; }
    out
}

fn report(name, r) = {
    print(name, "| kept", r.kept.rate, "% | ejected", r.ejected.rate, "% | crashed", r.crashed.rate,
          "% | habitable", r.habitable.mean, "% of the time | burns", r.burns.mean);
}

fn main() = {
    print("== Every launch:", UNIVERSES, "universes ==");
    let drifting = multiverse UNIVERSES { voyage(DRIFT) };
    report("drift   ", drifting);
    report("forecast", multiverse UNIVERSES { voyage(FORECAST) });
    report("edit    ", multiverse UNIVERSES { voyage(EDIT) });
    print("median distance from the stars (0.1 AU), every", WINDOW, "steps, drifting:", medians(drifting.track));

    # Conditioning: only the launches that started inside 2 AU
    let inner = multiverse UNIVERSES { let f = voyage(DRIFT); given f.inner; f };
    print("== Given it started inside 2 AU:", inner.kept.n, "of", UNIVERSES, "launches ==");
    report("drift   ", inner);
    report("edit    ", multiverse UNIVERSES { let f = voyage(EDIT); given f.inner; f });
}
