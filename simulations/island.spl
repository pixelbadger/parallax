# ============================================================
# Island: rabbits, foxes and a ranger.
#
# An island of 5 x 5 patches. Each month, on every patch:
#   grass grows with the season, times the patch's fertility
#   rabbits eat a unit of grass each; half the unfed starve; from
#     April to September the fed ones breed fast
#   foxes hunt the patch's rabbits; a fox needs one a month, and some
#     of the hungry starve; in spring the fed ones breed
#   crowded rabbits and hungry foxes wander to a neighbouring patch
# Some years bring drought (a third of the growth), and a crowded island
# risks myxomatosis in July, which kills most rabbits everywhere.
# Populations are counts; every rate is applied with random rounding.
#
# The ranger wants both species to survive the 8 years, and can:
#   LEAVE     never intervene
#   CULL      every January, halve the foxes on any patch with 2 or more
#   FORECAST  every January, foresee the year twice in forks, once after a
#             cull and once without, and cull only if that looks better
#             (the forks have their own weather, so foresight is imperfect)
#
# The island is surveyed once, and the survey is pinned: every universe,
# and the re-seeded study at the end, run on that same island.
# ============================================================

type Island = { grass, rabbits, foxes };
type Census = { both, rabbits_left, foxes_left, rabbits, foxes, early_drought, yearly, where };

let W = 5;
let H = 5;
let YEARS = 8;
let GROWTH = [6, 8, 16, 26, 36, 36, 30, 24, 16, 10, 6, 6];   # grass per month, January first
let DX = [1, 0, 0 - 1, 0];
let DY = [0, 1, 0, 0 - 1];
let OUTBREAK = 400;          # rabbits on the island before disease can strike
let UNIVERSES = 16;

let LEAVE = 0;
let CULL = 1;
let FORECAST = 2;

# n * pct%, randomly rounded so that it is right on average
fn chance(n, pct) = { (n * pct + observe open(0, 99)) / 100 }

fn grid(v) = { array(H, array(W, v)) }

fn total(g) = {
    let sum = 0;
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) { sum = sum + g[y][x]; x = x + 1; }
        y = y + 1;
    }
    sum
}

# Fertility of each patch, 5 - 15 (10 is average)
fn survey() = {
    let fert = grid(0);
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) { fert[y][x] = observe open(5, 15); x = x + 1; }
        y = y + 1;
    }
    fert
}

fn populate() = {
    let isle = Island { grass: grid(50), rabbits: grid(0), foxes: grid(0) };
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) {
            isle.rabbits[y][x] = observe open(0, 10);
            isle.foxes[y][x] = observe open(0, 1);
            x = x + 1;
        }
        y = y + 1;
    }
    isle
}

fn month(isle, fert, m, drought) = {
    let growth = GROWTH[m];
    if drought { growth = growth / 3; }
    let rabbits_in = grid(0);   # arrivals, settled after every patch has moved
    let foxes_in = grid(0);
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) {
            let grass = min(100, isle.grass[y][x] + growth * fert[y][x] / 10);
            let r = isle.rabbits[y][x];
            let f = isle.foxes[y][x];

            # Rabbits graze; half of the unfed starve
            let fed = min(grass, r);
            grass = grass - fed;
            r = max(0, r - chance(r - fed, 50) - chance(r, 3));
            if (m > 2 && m < 9) { r = r + chance(fed, 25); }

            # Foxes hunt; the hungry starve
            let prey = chance(min(r, f * 4), 30);
            r = r - prey;
            let fed_foxes = min(f, prey);
            f = max(0, f - chance(f - fed_foxes, 12) - chance(f, 2));
            if (m > 2 && m < 6) { f = f + chance(fed_foxes, 70); }

            # Crowded rabbits and hungry foxes wander to a neighbouring patch
            let dir = observe open(0, 3);
            let ny = y + DY[dir];
            let nx = x + DX[dir];
            let inland = ny > 0 - 1 && ny < H && nx > 0 - 1 && nx < W;
            if (inland && r > 4 && r > grass / 2) {
                let n = r / 4;
                r = r - n;
                rabbits_in[ny][nx] = rabbits_in[ny][nx] + n;
            }
            if (inland && f > 0 && prey < f) {
                let n = (f + 1) / 2;
                f = f - n;
                foxes_in[ny][nx] = foxes_in[ny][nx] + n;
            }

            isle.grass[y][x] = grass;
            isle.rabbits[y][x] = r;
            isle.foxes[y][x] = f;
            x = x + 1;
        }
        y = y + 1;
    }
    y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) {
            isle.rabbits[y][x] = isle.rabbits[y][x] + rabbits_in[y][x];
            isle.foxes[y][x] = isle.foxes[y][x] + foxes_in[y][x];
            x = x + 1;
        }
        y = y + 1;
    }
    isle
}

# Disease can strike a crowded island in July
fn outbreak(isle) = {
    if (total(isle.rabbits) > OUTBREAK && observe open(1, 100) < 40) {
        let y = 0;
        while (y < H) {
            let x = 0;
            while (x < W) {
                isle.rabbits[y][x] = isle.rabbits[y][x] - chance(isle.rabbits[y][x], 70);
                x = x + 1;
            }
            y = y + 1;
        }
    }
    isle
}

fn year(isle, fert, drought) = {
    let m = 0;
    while (m < 12) {
        isle = month(isle, fert, m, drought);
        if (m == 6) { isle = outbreak(isle); }
        m = m + 1;
    }
    isle
}

fn cull(isle) = {
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) {
            let f = isle.foxes[y][x];
            if (f > 1) { isle.foxes[y][x] = f - f / 2; }
            x = x + 1;
        }
        y = y + 1;
    }
    isle
}

# How well both species are doing: 0 if either has died out
fn outlook(isle) = {
    let r = total(isle.rabbits);
    let f = total(isle.foxes);
    if (r > 0 && f > 0) { min(r, f * 20) } else { 0 }
}

fn simulate(policy, fert) = {
    let isle = populate();
    let early_drought = 0;
    let yearly = array(YEARS, 0);
    let y = 0;
    while (y < YEARS) {
        let drought = observe open(1, 100) < 20;   # known to the ranger in January
        if (drought && y < 2) { early_drought = 1; }
        if (policy == CULL) { isle = cull(isle); }
        if (policy == FORECAST) {
            let culled = fork { outlook(year(cull(isle), fert, drought)) };
            let left = fork { outlook(year(isle, fert, drought)) };
            if (culled > left) { isle = cull(isle); }
            discard culled;
            discard left;
        }
        isle = year(isle, fert, drought);
        yearly[y] = total(isle.rabbits);
        y = y + 1;
    }
    let r = total(isle.rabbits);
    let f = total(isle.foxes);
    Census {
        both: r > 0 && f > 0, rabbits_left: r > 0, foxes_left: f > 0,
        rabbits: r, foxes: f, early_drought: early_drought,
        yearly: yearly, where: isle.rabbits,
    }
}

fn report(name, c) = {
    print(name, "| both survive", c.both.rate, "% | rabbits", c.rabbits_left.rate, "% | foxes",
          c.foxes_left.rate, "% | median at the end:", c.rabbits.median, "rabbits,", c.foxes.median, "foxes");
}

# Median of each element of an array of ensembles
fn medians(es) = {
    let out = [];
    let i = 0;
    while (i < len(es)) { out = push(out, es[i].median); i = i + 1; }
    out
}

fn show(g) = {
    let y = 0;
    while (y < len(g)) { print("   ", g[y]); y = y + 1; }
}

fn main() = {
    pin fertility = survey();
    print("Fertility of each patch (surveyed once, then pinned):");
    show(fertility);

    print("== Every universe:", UNIVERSES, "islands over", YEARS, "years ==");
    let leave = multiverse UNIVERSES { simulate(LEAVE, fertility) };
    report("leave   ", leave);
    report("cull    ", multiverse UNIVERSES { simulate(CULL, fertility) });
    report("forecast", multiverse UNIVERSES { simulate(FORECAST, fertility) });
    print("Median rabbits each year, left alone:", medians(leave.yearly));
    print("Where the rabbits end up (median per patch), left alone:");
    let y = 0;
    while (y < H) { print("   ", medians(leave.where[y])); y = y + 1; }

    # Conditioning: only the islands hit by drought in the first two years
    let dry = multiverse UNIVERSES { let c = simulate(LEAVE, fertility); given c.early_drought; c };
    print("== Given a drought in the first two years:", dry.both.n, "of", UNIVERSES, "islands ==");
    report("leave   ", dry);
    report("cull    ", multiverse UNIVERSES { let c = simulate(CULL, fertility); given c.early_drought; c });

    # Re-seeding changes the weather and the animals, not the pinned island
    print("== The same island under another seed ==");
    seed(99);
    pin fertility = survey();
    report("leave   ", multiverse UNIVERSES { simulate(LEAVE, fertility) });
    report("cull    ", multiverse UNIVERSES { simulate(CULL, fertility) });
}
